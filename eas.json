{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.12:3000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.hangora.app/api",
        "EXPO_PUBLIC_CHAT_URL": "https://secure-courage-production-8ba6.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.hangora.app/api",
        "EXPO_PUBLIC_CHAT_URL": "https://secure-courage-production-8ba6.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
