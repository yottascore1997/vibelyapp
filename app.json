{
  "expo": {
    "name": "Hangora",
    "slug": "vibematch",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vibematch",
    "splash": {
      "backgroundColor": "#8A56FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.speedza.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hangora uses your location to show people and hangouts near you with real distance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Hangora uses your location to show people and hangouts near you with real distance.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "in.speedza.app",
      "versionCode": 24,
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#8A56FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hangora to use your location to show real distance to people nearby."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#00000000"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4232a2a-d6f1-40de-97c2-939c78e537d8"
      }
    }
  }
}
